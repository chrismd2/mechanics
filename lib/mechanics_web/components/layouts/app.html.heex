<header class="px-4 sm:px-6 lg:px-8">
  <input type="checkbox" id="tools-drawer-toggle" class="peer sr-only" />

  <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
    <div class="flex items-center gap-4">
      <a href="/">
        <img src={~p"/images/logo.png"} width="555" alt="Mechanic's Electric Quest Log"/>
      </a>
    </div>
    <div class="flex items-center gap-4 font-semibold leading-6 text-zinc-900">
      <%= if @current_user do %>
        <.link
          href={~p"/account"}
          class="text-blue-600 underline hover:text-blue-800"
          id="header-welcome"
        >
          Welcome, <%= @current_user.name || @current_user.email %>!
        </.link>
        <%= if not @current_user.email_verified do %>
          <span class="rounded-md bg-amber-100 px-2 py-1 text-xs font-medium text-amber-900">
            Email not verified
          </span>
        <% end %>
        <%= if @chat_notification_feed && @chat_notification_feed.items != [] do %>
          <details id="header-chat-notifications" class="relative">
            <summary
              class="flex cursor-pointer list-none items-center gap-1 rounded-lg px-2 py-1 hover:bg-zinc-100 [&::-webkit-details-marker]:hidden"
              aria-label="Open message inbox"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 text-zinc-700"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
                />
              </svg>
              <%= if @chat_notification_feed.total_unread_messages > 0 do %>
                <span
                  id="header-notification-unread-badge"
                  class="min-w-[1.25rem] rounded-full bg-red-600 px-1.5 text-center text-xs font-bold text-white"
                >
                  <%= @chat_notification_feed.total_unread_messages %>
                </span>
              <% end %>
            </summary>
            <div
              id="header-notification-panel"
              class="absolute right-0 z-50 mt-2 max-h-80 w-80 overflow-y-auto rounded-lg border border-zinc-200 bg-white py-1 shadow-lg"
            >
              <ul id="header-notification-list" role="list" class="divide-y divide-zinc-100">
                <%= for item <- @chat_notification_feed.items do %>
                  <li
                    class="header-notification-row"
                    data-chat-id={item.chat_id}
                  >
                    <.link
                      href={~p"/chats/#{item.chat_id}"}
                      class="block px-3 py-2 hover:bg-zinc-50"
                    >
                      <div class="flex items-start justify-between gap-2">
                        <div class="min-w-0 flex-1">
                          <div class="text-sm font-medium text-zinc-900">
                            <%= item.title %>
                          </div>
                          <%= if item.details != [] do %>
                            <dl class="mt-1 space-y-0.5 border-t border-zinc-100 pt-1">
                              <%= for d <- item.details do %>
                                <div class="flex gap-1.5 text-xs leading-snug text-zinc-600">
                                  <dt class="shrink-0 font-medium text-zinc-500"><%= d.label %></dt>
                                  <dd class="min-w-0 line-clamp-2"><%= d.value %></dd>
                                </div>
                              <% end %>
                            </dl>
                          <% end %>
                        </div>
                        <%= if item.last_message_at do %>
                          <time
                            class="shrink-0 text-xs tabular-nums text-zinc-400"
                            datetime={datetime_html_attr(item.last_message_at)}
                            data-local-chat-time
                          >
                            …
                          </time>
                        <% end %>
                      </div>
                      <%= if item.preview != "" do %>
                        <div class="header-notification-preview mt-0.5 line-clamp-2 text-xs text-zinc-500">
                          <%= item.preview %>
                        </div>
                      <% end %>
                      <%= if item.unread_count > 0 do %>
                        <div class="mt-1 text-xs font-semibold text-red-600">
                          <%= item.unread_count %> unread
                        </div>
                      <% end %>
                    </.link>
                  </li>
                <% end %>
              </ul>
            </div>
          </details>
        <% end %>
        <.link
          href={~p"/logout"}
          method="delete"
          class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
        >
          Sign out <span aria-hidden="true">&rarr;</span>
        </.link>
      <% else %>
        <.link
          href={~p"/register"}
          class="rounded-lg bg-zinc-100 px-2 py-1 hover:bg-zinc-200/80"
        >
          Sign up
        </.link>
        <.link
          href={~p"/login"}
          class="rounded-lg bg-zinc-900 px-2 py-1 text-white hover:bg-zinc-800"
        >
          Sign in <span aria-hidden="true">&rarr;</span>
        </.link>
      <% end %>
    </div>
  </div>

  <%= if @current_user do %>
    <div class="flex items-center py-2">
      <label
        for="tools-drawer-toggle"
        id="tools-drawer-open"
        class="inline-flex cursor-pointer items-center justify-center rounded-lg border border-zinc-200 bg-white px-2.5 py-1.5 text-zinc-800 hover:bg-zinc-50"
        aria-label="Open tools"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="h-5 w-5"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
          />
        </svg>
      </label>
    </div>
  <% end %>

  <%= if @current_user do %>
    <label
      for="tools-drawer-toggle"
      id="tools-drawer-backdrop"
      class="pointer-events-none fixed inset-0 z-40 bg-zinc-900/40 opacity-0 transition-opacity peer-checked:pointer-events-auto peer-checked:opacity-100"
      aria-label="Close tools"
    >
    </label>
    <aside
      id="tools-drawer"
      class="fixed inset-y-0 left-0 z-50 flex w-72 max-w-[85vw] -translate-x-full flex-col border-r border-zinc-200 bg-white shadow-xl transition-transform duration-200 ease-out peer-checked:translate-x-0"
      aria-label="Tools"
    >
      <div class="flex items-center justify-between border-b border-zinc-100 px-4 py-3">
        <h2 class="text-sm font-semibold text-zinc-900">Tools</h2>
        <label
          for="tools-drawer-toggle"
          id="tools-drawer-close"
          class="cursor-pointer rounded-lg px-2 py-1 text-sm text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900"
        >
          Close
        </label>
      </div>
      <nav class="flex-1 overflow-y-auto px-2 py-3" aria-label="Tool links">
        <ul class="space-y-1">
          <li>
            <.link
              href={~p"/account"}
              class="block rounded-lg px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50"
            >
              Account
            </.link>
          </li>
          <%= if "customer" in (@current_user.roles || []) do %>
            <li>
              <.link
                href={~p"/listings/new"}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50"
              >
                Create job listing
              </.link>
            </li>
          <% end %>
          <%= if "mechanic" in (@current_user.roles || []) do %>
            <li>
              <.link
                href={~p"/profile"}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50"
              >
                Mechanic profile
              </.link>
            </li>
          <% end %>
          <%= if "pricing_user" in (@current_user.roles || []) do %>
            <li>
              <.link
                href={~p"/pricing"}
                id="tools-link-vehicle-pricing"
                class="block rounded-lg px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50"
              >
                Vehicle price suggestions
              </.link>
              <ul class="mt-0.5 space-y-0.5 border-l border-zinc-200 ml-3 pl-2">
                <li>
                  <.link
                    href={~p"/pricing/queries"}
                    id="tools-link-recent-searches"
                    class="block rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900"
                  >
                    Recent searches
                  </.link>
                </li>
              </ul>
            </li>
            <li>
              <.link
                href={~p"/pricing/market-prices/new"}
                id="tools-link-add-market-price"
                class="block rounded-lg px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50"
              >
                Add vehicle market price
              </.link>
            </li>
          <% end %>
          <%= if "admin" in (@current_user.roles || []) do %>
            <li>
              <.link
                href={~p"/admin"}
                id="tools-link-admin"
                class="block rounded-lg px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-zinc-50"
              >
                Admin
              </.link>
              <ul class="mt-0.5 space-y-0.5 border-l border-zinc-200 ml-3 pl-2">
                <li>
                  <.link
                    href={~p"/admin?tab=sources"}
                    id="tools-link-auction-sources"
                    class="block rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900"
                  >
                    Auction sources
                  </.link>
                </li>
                <li>
                  <.link
                    href={~p"/admin?tab=jobs"}
                    id="tools-link-admin-jobs"
                    class="block rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900"
                  >
                    Oban Jobs
                  </.link>
                </li>
                <li>
                  <.link
                    href={~p"/admin?tab=candidates"}
                    id="tools-link-admin-candidates"
                    class="block rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-600 hover:bg-zinc-50 hover:text-zinc-900"
                  >
                    Listing candidates
                  </.link>
                </li>
              </ul>
            </li>
          <% end %>
        </ul>
      </nav>
    </aside>
  <% end %>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class={["mx-auto", if(@wide_layout, do: "max-w-6xl", else: "max-w-2xl")]}>
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
