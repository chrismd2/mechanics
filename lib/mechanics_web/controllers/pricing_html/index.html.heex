<%
  step = assigns[:step] || :vin
  vehicle = @vehicle || %{}
  vin = Map.get(vehicle, "vin") || ""
  make = Map.get(vehicle, "make") || ""
  model = Map.get(vehicle, "model") || ""
  year = Map.get(vehicle, "year") || ""
  miles = Map.get(vehicle, "miles") || ""
  zipcode = Map.get(vehicle, "zipcode") || "00000"
  recent_queries = assigns[:recent_queries] || []
  similar_market_prices = assigns[:similar_market_prices] || []
%>

<div class="space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div class="space-y-2">
      <h1 class="text-2xl font-semibold text-zinc-900">Vehicle price suggestion</h1>
      <p class="text-sm text-zinc-600">
        <%= if step == :vin do %>
          Start with a VIN. We’ll check it against known market prices and a VIN decoder, then suggest prices.
        <% else %>
          Confirm the vehicle details and miles, then get competitive and expected-minimum suggestions.
        <% end %>
      </p>
    </div>
    <a
      href={~p"/pricing/market-prices/new"}
      class="shrink-0 text-sm font-semibold text-zinc-900 underline"
    >
      Add market price
    </a>
  </div>

  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_16rem]">
    <div class="space-y-6 min-w-0">
      <%= if step == :vin do %>
        <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
          <form action={~p"/pricing/from-vin"} method="post" class="space-y-6" id="vehicle_vin_form">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

            <div class="space-y-2">
              <label for="vehicle_vin" class="block text-sm font-semibold text-zinc-800">VIN</label>
              <input
                type="text"
                id="vehicle_vin"
                name="vehicle[vin]"
                value={vin}
                required
                maxlength="17"
                autocomplete="off"
                class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm uppercase"
              />
            </div>

            <div class="space-y-2">
              <label for="vehicle_miles" class="block text-sm font-semibold text-zinc-800">
                Miles (optional)
              </label>
              <input
                type="text"
                id="vehicle_miles"
                name="vehicle[miles]"
                value={miles}
                min="0"
                class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm"
              />
              <p class="text-xs text-zinc-500">
                Include miles now if you have them (defaults to 0); otherwise you can adjust them next.
              </p>
            </div>

            <div class="space-y-2">
              <label for="vehicle_zipcode" class="block text-sm font-semibold text-zinc-800">
                Zipcode (optional)
              </label>
              <input
                type="text"
                id="vehicle_zipcode"
                name="vehicle[zipcode]"
                value={zipcode}
                maxlength="10"
                inputmode="numeric"
                class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm"
              />
              <p class="text-xs text-zinc-500">Defaults to 00000 when blank.</p>
            </div>

            <div class="flex items-center gap-3">
              <button
                type="submit"
                class="inline-flex items-center rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700"
              >
                Check VIN
              </button>
              <a href={~p"/pricing?manual=1"} class="text-sm text-zinc-600 hover:text-zinc-900">Enter details manually</a>
            </div>
          </form>
        </div>
      <% else %>
        <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm">
          <form action={~p"/pricing/suggest"} method="post" class="space-y-6" id="vehicle_manual_form">
            <input type="hidden" name="_csrf_token" value={get_csrf_token()} />

            <div class="space-y-2">
              <label for="vehicle_vin" class="block text-sm font-semibold text-zinc-800">VIN</label>
              <input
                type="text"
                id="vehicle_vin"
                name="vehicle[vin]"
                value={vin}
                maxlength="17"
                autocomplete="off"
                class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm uppercase"
              />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="vehicle_make" class="block text-sm font-semibold text-zinc-800">Make</label>
                <input
                  type="text"
                  id="vehicle_make"
                  name="vehicle[make]"
                  value={make}
                  required
                  class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm"
                />
              </div>
              <div class="space-y-2">
                <label for="vehicle_model" class="block text-sm font-semibold text-zinc-800">Model</label>
                <input
                  type="text"
                  id="vehicle_model"
                  name="vehicle[model]"
                  value={model}
                  required
                  class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="space-y-2">
                <label for="vehicle_year" class="block text-sm font-semibold text-zinc-800">
                  Year <span class="font-normal text-zinc-500">(optional)</span>
                </label>
                <input
                  type="text"
                  id="vehicle_year"
                  name="vehicle[year]"
                  value={year}
                  class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm"
                />
              </div>
              <div class="space-y-2">
                <label for="vehicle_miles" class="block text-sm font-semibold text-zinc-800">
                  Miles <span class="font-normal text-zinc-500">(optional)</span>
                </label>
                <input
                  type="text"
                  id="vehicle_miles"
                  name="vehicle[miles]"
                  value={miles}
                  min="0"
                  class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm"
                />
                <p class="text-xs text-zinc-500">Defaults to 0 when blank.</p>
              </div>
            </div>

            <div class="space-y-2">
              <label for="vehicle_zipcode" class="block text-sm font-semibold text-zinc-800">Zipcode</label>
              <input
                type="text"
                id="vehicle_zipcode"
                name="vehicle[zipcode]"
                value={zipcode}
                maxlength="10"
                inputmode="numeric"
                class="mt-1 block w-full rounded-lg border-zinc-300 shadow-sm sm:text-sm"
              />
              <p class="text-xs text-zinc-500">Defaults to 00000 when blank.</p>
            </div>

            <div class="flex items-center gap-3">
              <button
                type="submit"
                class="inline-flex items-center rounded-lg bg-zinc-900 px-4 py-2 text-sm font-semibold text-white hover:bg-zinc-700"
              >
                Suggest prices
              </button>
              <a href={~p"/pricing"} class="text-sm text-zinc-600 hover:text-zinc-900">Start over with VIN</a>
            </div>
          </form>
        </div>
      <% end %>

      <%= if @query do %>
        <div class="rounded-xl border border-zinc-200 bg-white p-6 shadow-sm space-y-3">
          <h2 class="text-lg font-semibold text-zinc-900">
            <%= if @query.year in [nil, 0] and (@query.suggested_competitive_cents || @query.suggested_minimum_cents) do %>
              Best guess
            <% else %>
              Suggestion
            <% end %>
          </h2>

          <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
            <div>
              <dt class="font-semibold text-zinc-700">Competitive</dt>
              <dd class="text-zinc-900">
                <%= if @query.suggested_competitive_cents do %>
                  <%= MechanicsWeb.Helpers.CurrencyFormatter.format(
                    @query.suggested_competitive_cents,
                    @query.currency || "USD"
                  ) %>
                <% else %>
                  Insufficient data
                <% end %>
              </dd>
            </div>
            <div>
              <dt class="font-semibold text-zinc-700">Expected minimum</dt>
              <dd class="text-zinc-900">
                <%= if @query.suggested_minimum_cents do %>
                  <%= MechanicsWeb.Helpers.CurrencyFormatter.format(
                    @query.suggested_minimum_cents,
                    @query.currency || "USD"
                  ) %>
                <% else %>
                  Insufficient data
                <% end %>
              </dd>
            </div>
          </dl>

          <p class="text-sm text-zinc-600">
            Matched market prices: <%= @query.match_count %>
          </p>

          <%= if @query.agent_summary do %>
            <p class="text-sm text-zinc-700"><%= @query.agent_summary %></p>
          <% end %>

          <%= if @query.year in [nil, 0] or
                (is_nil(@query.suggested_competitive_cents) and is_nil(@query.suggested_minimum_cents)) do %>
            <div id="similar-market-prices" class="space-y-3 border-t border-zinc-100 pt-4">
              <p class="text-sm text-zinc-800">
                <%= if is_nil(@query.suggested_competitive_cents) and is_nil(@query.suggested_minimum_cents) do %>
                  I can't suggest a price, but here are some that are similar.
                <% else %>
                  Matching market prices (by year):
                <% end %>
              </p>

              <%= if similar_market_prices == [] do %>
                <p class="text-sm text-zinc-500">No similar market prices found.</p>
              <% else %>
                <ul class="space-y-2">
                  <%= for row <- similar_market_prices do %>
                    <li class="rounded-lg border border-zinc-200 px-3 py-2 text-sm text-zinc-800">
                      <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0 space-y-0.5">
                          <p class="font-medium">
                            <%= row.year %> <%= row.make %> <%= row.model %>
                          </p>
                          <p class="text-xs text-zinc-500">
                            <%= MechanicsWeb.Helpers.CurrencyFormatter.format_integer(row.miles) %> miles
                            · <%= row.price_type %>
                            · <%= MechanicsWeb.Helpers.CurrencyFormatter.format(
                              row.price_cents,
                              row.currency || "USD"
                            ) %>
                          </p>
                          <%= if row.source_url do %>
                            <a
                              href={row.source_url}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="text-xs text-zinc-600 underline hover:text-zinc-900"
                            >
                              Source
                            </a>
                          <% end %>
                        </div>
                        <form
                          action={~p"/pricing/queries/#{@query.id}/similar/#{row.id}/dismiss"}
                          method="post"
                          class="shrink-0"
                        >
                          <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                          <button
                            type="submit"
                            class="text-xs font-medium text-zinc-500 hover:text-zinc-800"
                          >
                            Dismiss
                          </button>
                        </form>
                      </div>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <aside id="recent-searches" class="space-y-3">
      <h2 class="text-sm font-semibold text-zinc-900">
        <a href={~p"/pricing/queries"} class="underline hover:text-zinc-700">Recent searches</a>
      </h2>

      <%= if recent_queries == [] do %>
        <p class="text-sm text-zinc-500">No recent searches yet.</p>
      <% else %>
        <ul class="space-y-2">
          <%= for query <- recent_queries do %>
            <li class="rounded-lg border border-zinc-200 bg-white shadow-sm">
              <form action={~p"/pricing/suggest"} method="post">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="vehicle[vin]" value={query.vin || ""} />
                <input type="hidden" name="vehicle[make]" value={query.make} />
                <input type="hidden" name="vehicle[model]" value={query.model} />
                <input type="hidden" name="vehicle[year]" value={if query.year in [nil, 0], do: "", else: query.year} />
                <input type="hidden" name="vehicle[miles]" value={query.miles} />
                <input type="hidden" name="vehicle[zipcode]" value={query.zipcode || "00000"} />
                <button
                  type="submit"
                  class="w-full px-3 py-2 text-left text-sm text-zinc-800 hover:bg-zinc-50"
                >
                  <span class="font-medium">
                    <%= if query.year not in [nil, 0] do %><%= query.year %> <% end %><%= query.make %> <%= query.model %>
                  </span>
                  <span class="mt-0.5 block text-xs text-zinc-500">
                    <%= MechanicsWeb.Helpers.CurrencyFormatter.format_integer(query.miles) %> miles
                  </span>
                </button>
              </form>
              <form action={~p"/pricing/queries/#{query.id}"} method="post" class="border-t border-zinc-100">
                <input type="hidden" name="_csrf_token" value={get_csrf_token()} />
                <input type="hidden" name="_method" value="delete" />
                <input type="hidden" name="return_to" value="/pricing" />
                <button
                  type="submit"
                  class="w-full px-3 py-1.5 text-left text-xs font-medium text-zinc-500 hover:bg-zinc-50 hover:text-zinc-800"
                >
                  Dismiss
                </button>
              </form>
            </li>
          <% end %>
        </ul>
      <% end %>
    </aside>
  </div>
</div>
